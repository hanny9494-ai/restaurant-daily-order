# Qwen (DashScope)
# 至少配置下面任意一个变量名，推荐 DASHSCOPE_API_KEY
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# DASHSCOPE_APIKEY=your_dashscope_api_key_here
# QWEN_API_KEY=your_dashscope_api_key_here

# 可选：模型覆盖（默认 qwen3.5-plus / qwen3.5-vl-plus）
QWEN_TEXT_MODEL=qwen3.5-plus
QWEN_VISION_MODEL=qwen3.5-vl-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# MCP chat backend
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=[]
MCP_SERVER_CWD=
MCP_PROTOCOL_VERSION=2024-11-05
MCP_CHAT_TOOL=chat
MCP_MULTI_AGENT_TOOL=multi_agent_chat

# 聊天入口模式
# single: 调用 MCP_CHAT_TOOL
# multi_agent: 调用 MCP_MULTI_AGENT_TOOL，若为空则退回 MCP_CHAT_TOOL
CHAT_MODE=single

# 当前主运行库
# sqlite: 本地 / Render 持久磁盘
# postgres: 下一阶段切到 Vercel + Marketplace Postgres 时使用
RECIPES_DB_PROVIDER=sqlite

# SQLite 运行时数据目录
# 本地默认使用 ./data
# Render 可改为 /var/data
DATA_DIR=
RECIPES_DB_MODE=
RECIPES_DB_FILE=app.db
L0_DB_FILE=l0_engine.db

# PostgreSQL（Vercel + Marketplace Postgres / 通用 Postgres）
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=
PG_POOL_MAX=5

# 可选：bangwagong webhook
BANGWAGONG_WEBHOOK_URL=
BANGWAGONG_API_TOKEN=
# BANGWAGONG_WEBHOOK_TOKEN=

# ---------------------------------------------------------------
# 新店独立部署（收货闭环 / 盘点 / 食材成本）
# 同一份代码，只要 DATA_DIR 不同，就是一套完全独立的数据（SQLite + 上传的单据图片）。
# 例：DATA_DIR=/var/data/store-b  RECIPES_DB_FILE=app.db
# ---------------------------------------------------------------
# 门店名（服务端显示用）；NEXT_PUBLIC_STORE_NAME 会写进前端（下单文本抬头），需在 build 前设置
STORE_NAME=
NEXT_PUBLIC_STORE_NAME=
# 新店不需要沿用老店默认供应商时设为 0（默认 1 = 启动时自动写入/启用默认供应商列表）
SEED_DEFAULT_SUPPLIERS=1
# 员工 PIN 登录会话签名密钥；留空则首次启动自动生成并保存在数据库 app_settings 中
STAFF_SESSION_SECRET=
# 收货单价与该品项上次合格进价偏差超过此比例则提醒并生成「单价差异」差异单（默认 0.15 = 15%，管理员可在设置页覆盖）
PRICE_DEVIATION_THRESHOLD=0.15
# 每周固定盘点日：0=周日 1=周一 ... 6=周六（默认 1，管理员可在设置页覆盖）
STOCKTAKE_WEEKDAY=1
# 盘点口径：END_OF_DAY=收市后盘点（盘点日当天的来货计入上一期）；START_OF_DAY=营业前盘点（当天来货计入下一期）
STOCKTAKE_TIMING=END_OF_DAY
# 消耗异常提示：某品项本期消耗较前 4 期均值偏差超过此比例（默认 0.3）
CONSUMPTION_ANOMALY_THRESHOLD=0.3
# 仅测试用：=1 时 /api/receiving/ocr 接受请求体 mock_ocr，不调用千问（e2e 脚本使用）。生产勿开。
RECEIVING_OCR_MOCK=
